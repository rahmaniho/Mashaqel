# نمونه پیکربندی سرور مرکزی (این فایل را به .env کپی و مقادیر را تغییر دهید)
PORT=8787
HOST=0.0.0.0
MASHQEL_DB=/var/lib/mashaqel/mashaqel.sqlite
MASHQEL_CORS_ORIGIN=https://mashaqel.example.org
MASHQEL_DOMAIN=mashaqel.example.org

# هویت سازمانی (SSO/OIDC) — برای فعال‌سازی پر کنید
MASHQEL_OIDC_ISSUER=
MASHQEL_OIDC_CLIENT_ID=
MASHQEL_OIDC_CLIENT_SECRET=
MASHQEL_OIDC_REDIRECT_URI=
MASHQEL_OIDC_APP_URL=
MASHQEL_OIDC_SCOPE=openid email profile
MASHQEL_OIDC_DEFAULT_ROLE=VIEWER
MASHQEL_OIDC_ADMIN_EMAILS=
MASHQEL_OIDC_LABEL=ورود با حساب سازمانی
# ورود با رمز محلی: on یا off (در نصب‌های فقط-SSO مقدار off بگذارید)
MASHQEL_LOCAL_LOGIN=on
